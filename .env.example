# Cấu hình Discord Bot
DISCORD_TOKEN=your_discord_bot_token_here

# ID Discord của Sếp Tổng (chuột phải tên -> Copy User ID, bật Developer Mode). Nhiều ID cách nhau dấu phẩy.
# Nếu bỏ trống: chủ bot (Developer Portal) và chủ server được coi là Sếp.
BOSS_USER_IDS=

# Chọn nguồn AI: "groq" (cloud miễn phí, cực nhanh) hoặc "ollama" (chạy local trên máy)
AI_PROVIDER=groq

# --- Cấu hình GROQ (Lấy key miễn phí tại: https://console.groq.com/keys) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=openai/gpt-oss-120b

# --- Cấu hình OLLAMA (Chạy local trên máy) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_TEXT_MODEL=llama3.2
OLLAMA_VISION_MODEL=llama3.2-vision

# --- Cấu hình Hội thoại ---
MAX_HISTORY=30
SYSTEM_PROMPT=Bạn là một trợ lý AI thông minh, thân thiện và hữu ích trong server Discord của team. Hãy trả lời tự nhiên bằng tiếng Việt, ngắn gọn, súc tích và hỗ trợ các thành viên giải quyết vấn đề hiệu quả.

# --- Google Sheet lưu dữ liệu: các tab Tasks, Trí nhớ, Nhắc việc, Cài đặt (bỏ trống thì lưu file local) ---
# Link hoặc ID của Google Sheet. Nhớ Share sheet cho email của Service Account (quyền Editor).
TASK_SHEET_ID=
TASK_SHEET_TAB=Tasks
# Dán nguyên nội dung file JSON key của Service Account (1 dòng), hoặc trỏ đường dẫn file
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Trí tuệ AI: mức "suy nghĩ" của model gpt-oss (low / medium / high, để trống để tắt) ---
AI_REASONING_EFFORT=medium

# --- Báo cáo tự động vào kênh #task (để trống để tắt) ---
DAILY_REPORT_TIME=08:30
WEEKLY_REPORT_TIME=17:30
# Tuỳ chọn: ID kênh nhận báo cáo & task từ Sheet (mặc định: kênh tên "task")
REPORT_CHANNEL_ID=
